			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:bvOcMOf73pJSDkB-pyr9l",
			"type": "text",
			"props": {
				"color": "black",
				"size": "m",
				"w": 357.87800625273036,
				"text": "* un conteneur represent une \n  instance d'une image, un\n  conteneur est executee par \n  le Docker Host, ce qui implique\n  l'xecution de l'application qu'il\n  transporte dans un environnement \n  isole fourni par le conteneur ",
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 0.7772612183517115
			},
			"parentId": "page:page",
			"index": "b0J0Wx",
			"typeName": "shape"
		},
