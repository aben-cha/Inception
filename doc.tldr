			"type": "text",
			"props": {
				"color": "black",
				"size": "m",
				"w": 262.9089391892858,
				"text": "* une image docker est\n  juste un fichier package\n  representant la\n  template des conteneurs\n  Elle definit la  structure \n  du conteneur en englobe\n  l'application containerisee\n  et l'ensemble de ses \n  dependances.\n* ensemble des fichiers",
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 0.7772612183517115
			},
			"parentId": "page:page",
